<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <handlers>
      <clear />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <clear />

        <!-- Imágenes de miembros — servidas directamente por IIS -->
        <rule name="ImgGiecom" stopProcessing="true">
          <match url="^ImgGiecom/(.+)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Todo lo demás va a Node.js -->
        <rule name="AllToNode" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <remove fileExtension=".jpg" />
      <remove fileExtension=".jpeg" />
      <remove fileExtension=".png" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".jpg"  mimeType="image/jpeg" />
      <mimeMap fileExtension=".jpeg" mimeType="image/jpeg" />
      <mimeMap fileExtension=".png"  mimeType="image/png" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <iisnode
      nodeProcessCommandLine="node"
      watchedFiles="web.config;*.js;.env"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
    />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
        <denyUrlSequences>
          <add sequence=".env" />
        </denyUrlSequences>
        <fileExtensions>
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Deshabilitar listado de directorios -->
    <directoryBrowse enabled="false" />

    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
